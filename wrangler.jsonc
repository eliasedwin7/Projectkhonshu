{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "projectkhonshu",
  "compatibility_date": "2026-10-01",
  "workers_dev": true,
  "assets": {
    "directory": "./public",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "none"
  },
  "build": { "command": "node scripts/build.mjs" }
}
